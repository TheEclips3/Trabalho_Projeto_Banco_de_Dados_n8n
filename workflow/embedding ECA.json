      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const INICIO = 0;    // posição do primeiro artigo a enviar\nconst LIMITE = 0;   // quantos artigos enviar (0 = todos a partir de INICIO)\n\nconst j = $input.first().json;\nlet t = String(j.text ?? j.data ?? '');   // Extract From PDF devolve \"text\"\n\nt = t.replace(/\\f/g, '\\n');\n\n// remove notas legislativas e a palavra \"Vigência\" solta\nt = t.replace(\n  /\\((?:Redação dada|Incluíd[oa]|Vide|Regulamento|Revogad[oa]|Expressão|Renumerad[oa]|Vetado|Produção de efeito)[^)]*\\)?/gi,\n  ''\n);\nt = t.replace(/\\bVigência\\b/g, '');\nt = t.replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n');\n\n// quebra por artigo; guarda a ÚLTIMA ocorrência de cada número (redação vigente)\nconst mapa = new Map();\nfor (const p of t.split(/\\n(?=\\s*Art\\.\\s*\\d+)/)) {\n  const s = p.trim();\n  const m = s.match(/^Art\\.\\s*(\\d+)\\s*[ºo°]?\\.?\\s*(?:-\\s*([A-Z]))?/);\n  if (!m) continue;\n  if (parseInt(m[1], 10) >= 263) continue;          // disposições finais\n  const num = m[1] + (m[2] ? '-' + m[2] : '');\n  const corpo = s.replace(/\\s+/g, ' ').trim();\n  if (corpo.length < 40) continue;                  // artigo revogado/vazio\n  mapa.set(num, corpo);\n}\n\nlet lista = [...mapa].slice(INICIO);\nif (LIMITE > 0) lista = lista.slice(0, LIMITE);\n\nreturn lista\n  .filter(([num, corpo]) => corpo && corpo.trim().length > 40)\n  .map(([num, corpo]) => ({\n    json: { artigo: `Art. ${num}`, content: corpo },\n  }));"
      },
